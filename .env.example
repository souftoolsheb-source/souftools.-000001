# GEMINI_API_KEY: Required for default Gemini model fallback (supports single key or comma-separated pool: "key1,key2,key3")
GEMINI_API_KEY=""

# GEMINI_API_KEYS: Optional secondary key pool list for automatic Round-Robin load balancing
GEMINI_API_KEYS=""

# APP_URL: Hosted URL of the application
APP_URL="http://localhost:3000"

# BETTER_AUTH_SECRET: Secret key for Better Auth tokens and password hashing (generate with openssl rand -hex 32)
BETTER_AUTH_SECRET=""

# BETTER_AUTH_URL: Base URL for Better Auth authentication endpoints
BETTER_AUTH_URL="http://localhost:3000"

# ENCRYPTION_SECRET: Used for encrypting stored provider keys (generate with openssl rand -hex 32)
ENCRYPTION_SECRET=""

# MASTER_ENCRYPTION_KEY: 256-bit AES-GCM Master Key for Envelope Encryption of AI Provider Keys
MASTER_ENCRYPTION_KEY=""

# DATA_ENCRYPTION_KEY: Optional alias for 256-bit AES-GCM Master Key (falls back to MASTER_ENCRYPTION_KEY)
DATA_ENCRYPTION_KEY=""

# SESSION_SECRET: Secret key for signing SoufTools HttpOnly session tokens and HMAC URLs
SESSION_SECRET=""

# ADMIN_EMAIL: Primary admin user email for SoufTools
ADMIN_EMAIL="souftoolsheb@gmail.com"

# ADMIN_MASTER_PASSWORD_HASH: SHA-256 hex digest of the master administrator access key
ADMIN_MASTER_PASSWORD_HASH=""

# E2B_API_KEY: Optional API Key for E2B Cloud Sandbox integration
E2B_API_KEY=""

# CRON_SECRET: Secret key used by cron jobs to authorize scheduled worker tasks
CRON_SECRET=""

# TURSO_DATABASE_URL: Authoritative Turso (libSQL) database URL (e.g. libsql://your-db-org.turso.io or file:./.turso_local/souftools.db)
TURSO_DATABASE_URL=""

# TURSO_AUTH_TOKEN: Auth token for Turso Cloud remote connections (required when TURSO_DATABASE_URL uses libsql:// or https://)
TURSO_AUTH_TOKEN=""

# GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for Better Auth
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Optional Google OAuth Client Secret for Better Auth
GOOGLE_CLIENT_SECRET=""

# GITHUB_CLIENT_ID: Optional GitHub OAuth Client ID for Better Auth
GITHUB_CLIENT_ID=""

# GITHUB_CLIENT_SECRET: Optional GitHub OAuth Client Secret for Better Auth
GITHUB_CLIENT_SECRET=""

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token from @BotFather for Telegram Gateway
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Secret token for validating Telegram incoming webhook requests
TELEGRAM_WEBHOOK_SECRET=""

# STORAGE_SIGNING_SECRET: Secret key for signing private object storage download URLs
STORAGE_SIGNING_SECRET=""

# SMTP_HOST: SMTP host for sending verification emails (e.g., smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"

# SMTP_PORT: SMTP port for sending verification emails (e.g., 465 for SSL, 587 for TLS)
SMTP_PORT="465"

# SMTP_USER: SMTP account user email for sending verification emails
SMTP_USER=""

# SMTP_PASS: SMTP App Password for sending verification emails
SMTP_PASS=""

# RESEND_API_KEY: Optional Resend API key for secondary fast cloud email gateway
RESEND_API_KEY=""
